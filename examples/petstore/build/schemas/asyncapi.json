{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Petstore Events",
    "version": "1.0.0",
    "description": "Change events published to petstore.pets.changed, and consumed back off it by the projection."
  },
  "channels": {
    "Pets.petstore.pets.changed": {
      "address": "petstore.pets.changed",
      "x-service": "Pets",
      "messages": {
        "PetChanged": {
          "$ref": "#/components/messages/PetChanged"
        }
      }
    }
  },
  "operations": {
    "onChange": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/Pets.petstore.pets.changed"
      },
      "summary": "Pet changed",
      "description": "A pet was created, updated or sold.\n\nRegisters a sink for change events; the Kafka producer is one of these.",
      "x-service": "Pets"
    },
    "applyChange": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/Pets.petstore.pets.changed"
      },
      "summary": "Pet changed, consumed",
      "description": "Applied by the consumer to bring a projection back in step.\n\nIdempotent by `eventId`, because a topic redelivers. This is the method the\nKafka consumer forwards to, so the event round-trips: service → topic →\nconsumer → service.",
      "x-service": "Pets"
    }
  },
  "components": {
    "messages": {
      "PetChanged": {
        "name": "PetChanged",
        "title": "PetChanged",
        "payload": {
          "$ref": "#/components/schemas/PetChanged"
        }
      }
    },
    "schemas": {
      "PetChanged": {
        "description": "A change event, as published to the `petstore.pets.changed` topic and as\nconsumed back off it.\n\nThe consumer feeds these to `PetStore.applyChange`, so one declaration is the\nproducer's payload, the consumer's parameter and the AsyncAPI message.",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "description": "What changed. The discriminant of {@link PetChanged}.",
            "enum": [
              "created",
              "updated",
              "sold"
            ]
          },
          "petId": {
            "type": "number",
            "format": "int32",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "pet": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number",
                "format": "int32",
                "minimum": 1,
                "maximum": 2147483647
              },
              "name": {
                "type": "string",
                "description": "The pet's call name.",
                "minLength": 1,
                "maxLength": 80,
                "examples": [
                  "Ada"
                ]
              },
              "species": {
                "description": "What kind of animal.\n\nA union of string literals rather than an `enum`: it is a type, so it costs\nnothing at runtime, and the value on the wire is the word itself in every\nformat - `\"dog\"` in JSON, YAML, XML, CSV and protobuf alike, where a numeric\nenum would be `1` in some and `Dog` in others.",
                "enum": [
                  "unknown",
                  "dog",
                  "cat",
                  "bird"
                ]
              },
              "status": {
                "description": "Where a pet is in its journey through the store.",
                "enum": [
                  "sold",
                  "available",
                  "pending"
                ]
              },
              "priceCents": {
                "type": "string",
                "format": "int64",
                "pattern": "^-?\\d+$",
                "description": "Retail price in minor units, so no float ever touches money."
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 16
              },
              "owner": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "email"
                ],
                "description": "Absent while the pet is still available."
              },
              "addedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "name",
              "species",
              "status",
              "priceCents",
              "tags",
              "addedAt"
            ],
            "description": "The pet as it now stands."
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "eventId",
          "kind",
          "petId",
          "pet",
          "occurredAt"
        ]
      }
    }
  }
}
