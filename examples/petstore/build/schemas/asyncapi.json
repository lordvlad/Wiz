{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Petstore Events",
    "version": "1.0.0",
    "description": "Change events published to petstore.pets.changed, and consumed back off it by the projection."
  },
  "channels": {
    "PetEvents.petstore.pets.changed": {
      "address": "petstore.pets.changed",
      "x-service": "PetEvents",
      "messages": {
        "PetChanged": {
          "$ref": "#/components/messages/PetChanged"
        }
      }
    }
  },
  "operations": {
    "petChanged": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/PetEvents.petstore.pets.changed"
      },
      "summary": "Pet changed",
      "description": "A pet was created, updated or sold.",
      "x-service": "PetEvents"
    },
    "onPetChanged": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/PetEvents.petstore.pets.changed"
      },
      "summary": "Pet changed, consumed",
      "description": "Applied by the consumer to bring a projection back in step.",
      "x-service": "PetEvents"
    }
  },
  "components": {
    "messages": {
      "PetEvents": {
        "name": "PetEvents",
        "title": "PetEvents",
        "payload": {
          "$ref": "#/components/schemas/PetEvents"
        }
      },
      "PetChanged": {
        "name": "PetChanged",
        "title": "PetChanged",
        "payload": {
          "$ref": "#/components/schemas/PetChanged"
        }
      }
    },
    "schemas": {
      "PetEvents": {
        "type": "object",
        "properties": {
          "petChanged": {
            "description": "A pet was created, updated or sold.",
            "type": "object",
            "properties": {}
          },
          "onPetChanged": {
            "description": "Applied by the consumer to bring a projection back in step.",
            "type": "object",
            "properties": {}
          }
        },
        "required": [
          "petChanged",
          "onPetChanged"
        ]
      },
      "PetChanged": {
        "description": "A change event, as published to the `petstore.pets.changed` topic and as\nconsumed back off it.\n\nThe consumer feeds these to `PetStore.applyChange`, so one declaration is the\nproducer's payload, the consumer's parameter and the AsyncAPI message.",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "description": "What changed. The discriminant of {@link PetChanged}.",
            "enum": [
              0,
              1,
              2
            ]
          },
          "petId": {
            "type": "number",
            "format": "int32",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "pet": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number",
                "format": "int32",
                "minimum": 1,
                "maximum": 2147483647
              },
              "name": {
                "type": "string",
                "description": "The pet's call name.",
                "minLength": 1,
                "maxLength": 80,
                "examples": [
                  "Ada"
                ]
              },
              "species": {
                "description": "What kind of animal. Ordinals are the protobuf enum values.",
                "enum": [
                  0,
                  1,
                  2,
                  3
                ]
              },
              "status": {
                "description": "Where a pet is in its journey through the store.",
                "enum": [
                  0,
                  1,
                  2
                ]
              },
              "priceCents": {
                "type": "string",
                "format": "int64",
                "pattern": "^-?\\d+$",
                "description": "Retail price in minor units, so no float ever touches money."
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 16
              },
              "owner": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "email"
                ],
                "description": "Absent while the pet is still available."
              },
              "addedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "name",
              "species",
              "status",
              "priceCents",
              "tags",
              "addedAt"
            ],
            "description": "The pet as it now stands."
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "eventId",
          "kind",
          "petId",
          "pet",
          "occurredAt"
        ]
      }
    }
  }
}
