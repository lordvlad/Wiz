{
  "openrpc": "1.3.2",
  "info": {
    "title": "Petstore RPC",
    "version": "1.0.0",
    "description": "JSON-RPC over WebSocket at ws://localhost:3000/rpc."
  },
  "methods": [
    {
      "name": "Pets.list",
      "summary": "List pets",
      "description": "Lists pets, filtered and capped.\n\nThe one operation offered in four representations. Each `@response 200`\ntag adds a media type to the *same* response object, so the document says\none 200 with four `content` entries.",
      "params": [
        {
          "name": "query",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/PetQuery"
          }
        }
      ],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Pet"
          }
        }
      }
    },
    {
      "name": "Pets.get",
      "summary": "Fetch a pet",
      "description": "Fetches one pet as JSON or as protobuf.\n\nThe protobuf representation is encoded by `encodeProto<Pet>`, generated\nfrom the same `@fieldNumber` declarations as `build/schemas/petstore.proto`.",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": "number"
          }
        }
      ],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Pet"
        }
      }
    },
    {
      "name": "Pets.add",
      "summary": "Add a pet",
      "description": "Adds a pet to the store and publishes a change event.",
      "params": [
        {
          "name": "body",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/NewPet"
          }
        }
      ],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Pet"
        }
      }
    },
    {
      "name": "Pets.sell",
      "summary": "Sell a pet",
      "description": "Sells a pet to an owner and publishes a change event.",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": "number"
          }
        },
        {
          "name": "body",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Sale"
          }
        }
      ],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/Pet"
        }
      }
    },
    {
      "name": "Pets.remove",
      "summary": "Remove a pet",
      "description": "Removes a pet. No body, so no content.",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": "number"
          }
        }
      ],
      "paramStructure": "by-name",
      "result": {
        "name": "result",
        "schema": {}
      }
    },
    {
      "name": "rpc.discover",
      "summary": "Returns OpenRPC schema description",
      "params": [],
      "result": {
        "name": "OpenRPC",
        "schema": {
          "type": "object"
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "PetQuery": {
        "type": "object",
        "properties": {
          "status": {
            "anyOf": [
              {
                "const": "available"
              },
              {
                "const": "pending"
              },
              {
                "const": "sold"
              }
            ],
            "description": "Restrict to one status."
          },
          "q": {
            "type": "string",
            "description": "Substring match on the name, case-insensitive."
          },
          "limit": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      },
      "Pet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "minimum": -2147483648,
            "format": "int32",
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "description": "The pet's call name.",
            "minLength": 1,
            "maxLength": 80,
            "examples": [
              "Ada"
            ]
          },
          "species": {
            "$ref": "#/components/schemas/Species"
          },
          "status": {
            "$ref": "#/components/schemas/PetStatus"
          },
          "priceCents": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?\\d+$",
            "description": "Retail price in minor units, so no float ever touches money."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 16
          },
          "owner": {
            "$ref": "#/components/schemas/Owner",
            "description": "Absent while the pet is still available."
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "species",
          "status",
          "priceCents",
          "tags",
          "addedAt"
        ]
      },
      "Species": {
        "description": "What kind of animal.\n\nA union of string literals rather than an `enum`: it is a type, so it costs\nnothing at runtime, and the value on the wire is the word itself in every\nformat - `\"dog\"` in JSON, YAML, XML, CSV and protobuf alike, where a numeric\nenum would be `1` in some and `Dog` in others.",
        "anyOf": [
          {
            "const": "unknown"
          },
          {
            "const": "dog"
          },
          {
            "const": "cat"
          },
          {
            "const": "bird"
          }
        ]
      },
      "PetStatus": {
        "description": "Where a pet is in its journey through the store.",
        "anyOf": [
          {
            "const": "available"
          },
          {
            "const": "pending"
          },
          {
            "const": "sold"
          }
        ]
      },
      "Owner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "NewPet": {
        "description": "The body accepted when creating a pet: the store assigns `id` and `addedAt`.",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "species": {
            "$ref": "#/components/schemas/Species"
          },
          "priceCents": {
            "type": "string",
            "format": "int64",
            "pattern": "^-?\\d+$"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "species",
          "priceCents"
        ]
      },
      "Sale": {
        "description": "The body accepted when selling a pet.",
        "type": "object",
        "properties": {
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "ownerName": {
            "type": "string",
            "minLength": 1
          },
          "ownerEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "ownerId",
          "ownerName",
          "ownerEmail"
        ]
      }
    }
  }
}
